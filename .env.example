# ── whips · environment ─────────────────────────────────────────────
# Copy to .env.local. Nothing here is required to run the site; without a
# launcher address the garage reads as empty ("nothing launched yet").

# Robinhood Chain (defaults shown). Override to point the site at a fork.
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=4663
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com

# The deployed WhipsLauncher. When unset, next.config.ts falls back to
# contracts/deployments/robinhood.json (written by `npm run deploy:robinhood`
# inside contracts/). The deploy block bounds the ItemClaimed log scan.
NEXT_PUBLIC_WHIPS_LAUNCHER=
NEXT_PUBLIC_WHIPS_DEPLOY_BLOCK=

# Public URL of the site (used for metadata and the default token logo URL).
NEXT_PUBLIC_SITE_URL=https://whips.example
NEXT_PUBLIC_X_URL=

# WalletConnect project id (https://cloud.reown.com). Optional: without it
# only injected browser wallets are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Token logo uploads. Pinata JWT (server-side only). Without it the launch
# form uses the site's own /logo/<car>.png URL or any https URL you paste.
PINATA_JWT=

# ── contracts/ (Hardhat) — put these in contracts/.env ──────────────
# DEPLOYER_PRIVATE_KEY=0x…          funded on Robinhood Chain, deploys the launcher
# ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# FORK_URL=https://rpc.mainnet.chain.robinhood.com   for `npm run fork:check`
# ROBINHOOD_EXPLORER_API_URL=https://robinhoodchain.blockscout.com/api
