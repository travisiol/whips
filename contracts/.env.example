# Deployer (funded on Robinhood Chain). Never commit .env.
DEPLOYER_PRIVATE_KEY=
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_CHAIN_ID=4663
# For scripts/fork-check.ts, scripts/serve-fork.ts (in-process fork):
FORK_URL=https://rpc.mainnet.chain.robinhood.com
# Optional: pin the fork to a block
FORK_BLOCK=
# Blockscout verification
ROBINHOOD_EXPLORER_API_URL=https://robinhoodchain.blockscout.com/api
ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com
ROBINHOOD_EXPLORER_API_KEY=
# Optional overrides for deploy.ts
PONS_FACTORY_ADDRESS=
CATALOG_ROOT=
